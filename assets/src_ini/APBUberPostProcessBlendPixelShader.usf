/***************************************************************************************/
/*! Verux
****************************************************************************************/

#include "Common.usf"
#include "PostProcessCommon.usf"

#define SET_COLORGRADING 0 // Color grading: 1 = On, 0 = off

// Keep 30% of the original color saturation.
#define COLOR_SATURATION 0.30f

// Color grading parameters.
#if SET_COLORGRADING
    sampler2D ColorGradingLUT;
#endif

void Main(
    in float2 UV : TEXCOORD0,
    in float2 SceneUV : TEXCOORD1,
    out float4 OutColor : COLOR0
)
{
    float4 sceneColor = tex2D(SceneColorTexture, SceneUV);

    float3 FinalColor;
    #if SET_COLORGRADING
        FinalColor = ColorLookupTable(ColorGradingLUT, sceneColor.rgb);
    #else
        FinalColor = sceneColor.rgb;
    #endif

    float luminance = dot(FinalColor, float3(0.2126f, 0.7152f, 0.0722f));
    float3 DesaturatedColor = lerp(float3(luminance, luminance, luminance), FinalColor, COLOR_SATURATION);

    OutColor = float4(DesaturatedColor, sceneColor.a);
}
